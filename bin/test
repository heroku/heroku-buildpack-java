#!/usr/bin/env bash

set -euo pipefail

BUILD_DIR="${1}"
ENV_DIR="${2}"
# ARTIFACT_DIR="${3}"

BUILDPACK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && cd .. && pwd)"

source "${BUILDPACK_DIR}/lib/output.sh"
source "${BUILDPACK_DIR}/lib/util.sh"
source "${BUILDPACK_DIR}/lib/java_properties.sh"
source "${BUILDPACK_DIR}/lib/maven.sh"

util::export_env_dir "${ENV_DIR}" "." "JAVA_OPTS|JAVA_TOOL_OPTIONS"

cd "${BUILD_DIR}"

maven_opts=(-B)
global_settings_path=$(mktemp)

if maven::write_central_mirror_settings "${global_settings_path}"; then
	maven_opts+=(--global-settings "${global_settings_path}")
fi

if maven::should_use_wrapper "${BUILD_DIR}"; then
	if [[ -z "${MVNW_REPOURL:-}" ]] && maven::wrapper_supports_mirror "${BUILD_DIR}"; then
		export MVNW_REPOURL="${MAVEN_CENTRAL_MIRROR_URL}"
	fi

	./mvnw "${maven_opts[@]}" "${MAVEN_HEROKU_CI_GOAL:-test}"
else
	mvn "${maven_opts[@]}" "${MAVEN_HEROKU_CI_GOAL:-test}"
fi
